# Optional: AI dialogue. The offline game needs no credentials.
# Set these only in the server environment or a local ignored .env file.
# Or use the in-game AI setup page. Setup-saved configuration takes precedence.
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_API_KEY=
# Optional owner setup code: at least 16 characters. Blank generates a private file.
AI_SETUP_TOKEN=
# Optional private persistent configuration directory (defaults to .local).
# AI_CONFIG_DIR=/private/path/lanternmere
PORT=4173
